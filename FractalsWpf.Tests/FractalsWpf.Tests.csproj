    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.83.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
